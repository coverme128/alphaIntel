{
  "name": "alpha-capital-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx src/server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node --import tsx src/server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm test && npm run build",
    "replay": "node --import tsx scripts/replay.ts",
    "format": "prettier --write src tests scripts vite.config.ts",
    "market:check": "node --import tsx scripts/market-check.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "decimal.js": "^10.6.0",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.22.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.1.0"
  }
}
