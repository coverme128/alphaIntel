{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ActionPlan",
  "type": "object",
  "required": [
    "planId",
    "opportunityId",
    "mode",
    "legs",
    "expiresAt"
  ],
  "properties": {
    "planId": {
      "type": "string"
    },
    "opportunityId": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "PAPER",
        "ASSISTED",
        "AUTO"
      ]
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "legs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "venue",
          "symbol",
          "side",
          "orderType",
          "notionalUsd"
        ],
        "properties": {
          "venue": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "side": {
            "enum": [
              "BUY",
              "SELL"
            ]
          },
          "positionIntent": {
            "enum": [
              "OPEN_LONG",
              "OPEN_SHORT",
              "CLOSE_LONG",
              "CLOSE_SHORT",
              "SPOT_BUY",
              "SPOT_SELL"
            ]
          },
          "orderType": {
            "enum": [
              "LIMIT",
              "MARKET",
              "POST_ONLY",
              "IOC"
            ]
          },
          "notionalUsd": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "limitPrice": {
            "type": [
              "number",
              "null"
            ]
          },
          "maxSlippageBps": {
            "type": "number",
            "minimum": 0
          },
          "clientOrderId": {
            "type": "string"
          }
        }
      }
    },
    "failurePolicy": {
      "type": "object"
    }
  }
}